# PixelLoad Environment Variables Example
# Copy this file to .env.local and fill in your values

# Convex Backend
EXPO_PUBLIC_CONVEX_URL=your-convex-deployment-url

# AdMob (Production IDs)
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXX/XXXXXXXXXX

# AI & Media APIs
VISIONCO_API_KEY=your-visionco-api-key
EXPO_PUBLIC_YOUTUBE_API_KEY=your-youtube-api-key
